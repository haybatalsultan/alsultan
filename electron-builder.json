{
  "appId": "com.haybatalsultan.pro",
  "productName": "Haybat Al Sultan PRO",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server_libsql.cjs",
    "cloudConfig.cjs",
    "license.cjs",
    "package.json",
    "node_modules/**/*"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "public/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Haybat Al Sultan PRO",
    "installerLanguages": ["Arabic", "English"]
  }
}
